# Build output: clips and ground truth are regenerated from a seed, never committed.
data/clips/*
data/gt/*
data/calib/*.json
!data/clips/.gitkeep
!data/gt/.gitkeep
!data/calib/.gitkeep

.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

node_modules/
frontend/dist/
frontend/.vite/

.DS_Store
Thumbs.db
.idea/
.vscode/

# TypeScript incremental build state; regenerated by every build.
frontend/*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
