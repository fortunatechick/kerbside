# Build output: clips and ground truth are regenerated from a seed, never committed.
data/clips/*
data/gt/*
data/calib/*.json
!data/clips/.gitkeep
!data/gt/.gitkeep
!data/calib/.gitkeep

.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

node_modules/
frontend/dist/
# The web build goes elsewhere, so it can never replace what the local server serves.
frontend/dist-web/
frontend/.vite/

.DS_Store
Thumbs.db
.idea/
.vscode/

# TypeScript incremental build state; regenerated by every build.
frontend/*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Vercel CLI project state, including anonymous-deployment claim codes.
.vercel

# Build products of `npm run build:web` (the in-browser engine).
frontend/public/engine/kerbside.json
frontend/public/docs/
